# ---------------------------------------------------------------------------
# LOCAL RUNTIME (recommended — no API key, no network, nothing leaves your box)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible server works. Defaults to LM Studio's address, so if you
# run LM Studio on the same machine you can leave both of these unset.
#
#   LM Studio   http://localhost:1234/v1   (Developer tab -> Start Server)
#   Ollama      http://localhost:11434/v1
#   llama.cpp   http://localhost:8080/v1   (llama-server)
#   vLLM        http://localhost:8000/v1
LOCAL_BASE_URL="http://localhost:1234/v1"

# LM Studio ignores the value but wants the header present. Set a real key only
# if you put an authenticating proxy in front of your runtime.
LOCAL_API_KEY="lm-studio"

# Override the system prompt without editing server.ts.
# GODMODE_SYSTEM_PROMPT="You are a helpful assistant."

# ---------------------------------------------------------------------------
# HOSTED PROVIDERS (all optional — only needed for non-local models)
# ---------------------------------------------------------------------------
# HUGGING_FACE_TOKEN: for the `hf` provider models.
# Note: HF serverless inference for these models now routes through paid
# Inference Providers, so a free account will get 402/404 on most of them.
# Get a token at https://huggingface.co/settings/tokens
HUGGING_FACE_TOKEN="MY_HF_TOKEN"

# OPENROUTER_API_KEY: access to the hosted models in the model list.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
